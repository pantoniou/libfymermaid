# The imported mermaid corpus is verbatim upstream test input. Trailing
# whitespace in a case is significant; one case exists to test exactly that.
# Exempt the corpus from the whitespace checks so that `git diff --check`
# stays useful for the code.
test/mermaid-suite/**/*.mmd -whitespace

# A `.model` golden is emitter output, not hand-written. libfyaml folds a
# multi-line quoted scalar onto continuation lines that carry indentation, so
# a golden can hold trailing whitespace that must not be edited away.
test/**/*.model -whitespace
